# Exclude Git metadata.
.git
.gitignore

# Exclude local virtual environments, which are typically the largest context entries.
.venv
venv
ENV
data
!internal/search/data/
!internal/search/data/**
scripts/auto_download

# Obfuscation is a development build step; only generated browser assets ship.
node_modules/
package.json
package-lock.json

# Exclude Python bytecode.
__pycache__
*.pyc

# Exclude local Go build artifacts and caches.
frontiercloud.exe
.gocache

# Exclude IDE configuration.
.idea
.vscode

# Exclude local sensitive data.
.env
certs/

# Guard against reintroduced Python application sources; script/test drivers are not runtime assets.
app/
main.py
pyproject.toml
tests/
scripts/
!scripts/
scripts/*
!scripts/foc
!scripts/install-foc.sh
docs/
!docs/operator-manual.md
!docs/operator-upgrade.md
!docs/operator-recovery-sets.md
.fc-deployment.json
.fc-images.json
.fc-install.lock/
.fc-operation.lock/

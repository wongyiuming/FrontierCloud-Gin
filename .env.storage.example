# Fresh direct storage. Existing identities/data require the migration guide.
COMPOSE_FILE=docker-compose.storage.yaml
COMPOSE_PROJECT_NAME=frontiercloud-storage
# Optional reviewed published SHA. fc install records immutable image digests.
# FRONTIERCLOUD_REVISION=<published-full-SHA>
TLS_ENABLED=true
# DNS hostname or this node's bare public IPv4/IPv6 address.
# Use the same identity in STORAGE_ENDPOINT; IPv6 URLs require [address].
SERVER_NAME=storage.4399.com
STORAGE_ENDPOINT=https://storage.4399.com
# IP certificates are short-lived and renew automatically; reserve port 80
# for this node's HTTP-01 validation rather than sharing it with another ACME client.
# Direct is the default: public HTTPS is fixed at 443, ACME temporarily uses 80.
# For a relay, set all three together instead:
# STORAGE_TRANSPORT=relay
# STORAGE_PORT=8443
# STORAGE_ENDPOINT=https://storage.4399.com:8443
# Relay communication uses its high port; idle nodes do not bind 80/443.

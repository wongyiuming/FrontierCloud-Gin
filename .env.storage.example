# Fresh storage appliance only. Do not use a fresh identity to adopt managed files.
COMPOSE_FILE=docker-compose.storage.yaml
COMPOSE_PROJECT_NAME=frontiercloud-storage
FRONTIERCLOUD_REVISION=REPLACE_WITH_EXACT_40_CHARACTER_COMMITTED_SHA
DEPLOYMENT_MODE=only_stroge
DB_TYPE=sqlite
DATA_DIRECTORY=./storage-data
SERVER_NAME=storage.example.com
STORAGE_PORT=8443
STORAGE_ENDPOINT=https://storage.example.com:8443
PUBLIC_BIND_ADDRESS=0.0.0.0
# Both files must be readable by UID 10001; private key permissions stay private.
SSL_CERT_PATH=./certs/storage-fullchain.pem
SSL_KEY_PATH=./certs/storage-privkey.pem
# These settings are inert on storage: no updater or release API is deployed.
RELEASE_BRANCH=main
RELEASE_SOURCE_BRANCH=dev
